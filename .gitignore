# Secrets - never commit
.env
.env.*
!.env.example
.env.txt

# Local data
data/
*.db
*.db-shm
*.db-wal

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/

# Models / notebooks
# Per the user: model weights (XGBoost .pkl, PyTorch GATv2 .pt,
# and their per-model .meta.json sidecars) are NOT committed.
# Local-only — they're regenerated by the offline training jobs.
# NOTE: dashboard / backtest JSON reports are written to models/
# but those are gitignored separately below to keep this rule
# readable.
models/*.pkl
models/*.pt
models/*.meta.json
notebooks/.ipynb_checkpoints/

# Spec / planning docs (kept locally; never committed)
*.docx
specs/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Reports
reports/
*.log
# Dashboard / backtest JSON reports live alongside the trained
# model artifacts in models/. They are regenerated by the
# dashboard / backtest scripts and shouldn't pollute the repo.
models/ablation_*.json
models/backtest_*.json
models/cycle_traces/
