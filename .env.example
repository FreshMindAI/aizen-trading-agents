# Required for any real Alpaca calls (data + paper trading).
# Find paper keys at https://app.alpaca.markets -> Paper -> View
# Don't commit a real .env to git. The repo .gitignore lists .env.
ALPACA_API_KEY_ID=PK...your_paper_key
ALPACA_API_SECRET_KEY=your_paper_secret

# Optional: override the SQLite location. On Render the Cron Job
# blueprint mounts a persistent disk at /var/data/aizen and points
# AIZEN_DB_PATH there; locally this defaults to ./data/trading.db.
AIZEN_DB_PATH=/var/data/aizen/trading.db

# LLM provider. Default "mock" never reaches the network. Use
# "anthropic" with the GMI-serving proxy for live reasoning.
AIZEN_LLM_PROVIDER=mock
# AIZEN_LLM_PROVIDER=anthropic
# ANTHROPIC_AUTH_TOKEN=...          # never commit
# ANTHROPIC_BASE_URL=https://api.gmi-serving.com
# ANTHROPIC_MESSAGES_PATH=/v1/messages

# Run mode. paper = Alpaca paper account (real orders, no real money).
# dry-run = no orders submitted, no broker call. live = real money.
RUN_MODE=paper

# Per-cycle JSONL trace. ON in production (cheap, ~1KB/cycle) for
# debugging; OFF only if disk pressure becomes a concern.
AIZEN_TRACE=1

# Trading universe (comma-separated tickers). Defaults to a 10-name
# liquid mega-cap set; override to a smaller subset for the hackathon
# demo if Alpaca rate limits become a concern.
UNIVERSE=SPY,QQQ,AAPL,MSFT,NVDA,AMZN,META,GOOGL,TSLA,AMD

# Optional: tighten the LLM HTTP timeout if the GMI proxy is slow.
# Defaults to 30s; lower to fail fast.
# AIZEN_LLM_TIMEOUT_S=15
